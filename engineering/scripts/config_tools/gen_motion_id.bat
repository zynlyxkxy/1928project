@echo off
setlocal

rem -- repo root = two levels up from this script (scripts\config_tools) --
for %%I in ("%~dp0..\..\..") do set "ROOT=%%~fI"
set "CFG=%ROOT%\engineering\config"
set "OUT=%~dp0"

rem -- Check input folder exists --
if not exist "%CFG%\motion_config" (
    echo [ERROR] Not found: %CFG%\motion_config
    exit /b 1
)

rem -- Extract embedded PowerShell generator from this file and run it --
rem    IN  = repo config dir (reads motion_config\motionN\config.json)
rem    OUT = this script's folder (writes motion_axis_id.h / motion_stage_id.h)
powershell -NoProfile -ExecutionPolicy Bypass -Command "$l = Get-Content -LiteralPath '%~f0' -Encoding UTF8; $s = ($l | Select-String -Pattern '^rem ===== PS-START =====$' | Select-Object -First 1).LineNumber; $e = ($l | Select-String -Pattern '^rem ===== PS-END =====$' | Select-Object -First 1).LineNumber; $code = $l[$s..($e-2)]; $ps = Join-Path $env:TEMP 'gen_motion_id.ps1'; Set-Content -LiteralPath $ps -Value $code -Encoding UTF8; $env:IO_CFG_DIR = '%CFG%'; $env:IO_OUT_DIR = '%OUT%'; powershell -NoProfile -ExecutionPolicy Bypass -File $ps; exit $LASTEXITCODE"
if errorlevel 1 (
    del /q "%TEMP%\gen_motion_id.ps1" 2>nul
    echo [ERROR] Failed to generate motion_axis_id.h / motion_stage_id.h
    exit /b 1
)

del /q "%TEMP%\gen_motion_id.ps1" 2>nul

echo [OK] Generated: %OUT%motion_axis_id.h and %OUT%motion_stage_id.h
exit /b 0

rem ===== PS-START =====
$ErrorActionPreference = 'Stop'

# Enum member names must be valid C++ identifiers (space/CJK/digit-leading names
# would break the generated header on the consumer side)
function Assert-ValidEnumName([string]$n, [string]$ctx) {
    if ([string]::IsNullOrWhiteSpace($n)) { throw "Empty enum member name at: $ctx" }
    if ($n -notmatch '^[A-Za-z_][A-Za-z0-9_]*$') { throw "Invalid enum member name '$n' at: $ctx (must be a C++ identifier)" }
}

$dir = $env:IO_CFG_DIR
if ([string]::IsNullOrWhiteSpace($dir)) { throw 'IO_CFG_DIR is not set' }
$outDir = $env:IO_OUT_DIR
if ([string]::IsNullOrWhiteSpace($outDir)) { $outDir = $dir }

$motionDir = Join-Path $dir 'motion_config'
if (-not (Test-Path -LiteralPath $motionDir)) { throw "Not found: $motionDir" }

$axisOut = Join-Path $outDir 'motion_axis_id.h'
$stageOut = Join-Path $outDir 'motion_stage_id.h'

# Collect stages across motionN folders (numeric order), acs_stages then plc_stages.
$stages = New-Object 'System.Collections.Generic.List[object]'
$seen = @{}
$configDirs = @(Get-ChildItem -LiteralPath $motionDir -Directory | Where-Object { $_.Name -match '^motion\d+$' } | Sort-Object { [int]($_.Name -replace '^motion', '') })
foreach ($cd in $configDirs) {
    $cfgPath = Join-Path $cd.FullName 'config.json'
    if (-not (Test-Path -LiteralPath $cfgPath)) { continue }
    $cfg = Get-Content -Raw -Encoding UTF8 -LiteralPath $cfgPath | ConvertFrom-Json
    foreach ($kind in 'acs_stages', 'plc_stages') {
        $arr = $cfg.PSObject.Properties[$kind].Value
        if ($null -eq $arr) { continue }
        foreach ($st in @($arr)) {
            $name = [string]$st.name
            if ([string]::IsNullOrWhiteSpace($name)) { continue }
            if ($seen.ContainsKey($name)) { continue }   # keep first occurrence
            Assert-ValidEnumName $name ('stage under ' + $cfgPath)
            $seen[$name] = $true
            $axes = New-Object 'System.Collections.Generic.List[string]'
            $an = $st.PSObject.Properties['axisNames'].Value
            if ($null -ne $an) { foreach ($a in @($an)) { Assert-ValidEnumName ([string]$a) ("axis of stage " + $name); $axes.Add([string]$a) } }
            $stages.Add([pscustomobject]@{ name = $name; axes = $axes })
        }
    }
}

if ($stages.Count -eq 0) { throw 'No stages found under ' + $motionDir }

$utf8NoBom = New-Object System.Text.UTF8Encoding($false)
$out = New-Object System.Text.StringBuilder
function AddLine([string]$t) { [void]$out.AppendLine($t) }

# ---- motion_axis_id.h ----
AddLine '/*********************************************************************************'
AddLine '* @Copyright(C), 2026 ISTAR. All rights reserved.'
AddLine '* @FileName: motion_axis_id.h'
AddLine '* @Description: motion stage axis index enum, same order as axisNames in config.json.'
AddLine '*               generated by gen_motion_id.bat - do not edit by hand.'
AddLine '*********************************************************************************/'
AddLine '#ifndef __MOTION_AXIS_ID_H__'
AddLine '#define __MOTION_AXIS_ID_H__'
AddLine ''
AddLine 'namespace Axis'
AddLine '{'
foreach ($st in $stages) {
    AddLine ('    enum class ' + $st.name)
    AddLine '    {'
    $maxLen = 0
    foreach ($ax in $st.axes) { if ($ax.Length -gt $maxLen) { $maxLen = $ax.Length } }
    $n = $st.axes.Count
    for ($j = 0; $j -lt $n; $j++) {
        $ax = $st.axes[$j].PadRight($maxLen)
        $comma = ','
        if ($j -eq $n - 1) { $comma = '' }
        AddLine ('        ' + $ax + ' = ' + $j + $comma)
    }
    AddLine '    };'
    AddLine ''
}
AddLine '} // namespace Axis'
AddLine ''
AddLine '#endif // __MOTION_AXIS_ID_H__'

[System.IO.File]::WriteAllText($axisOut, $out.ToString(), $utf8NoBom)
Write-Host "[OK] Generated: $axisOut"

# ---- motion_stage_id.h ----
$out = New-Object System.Text.StringBuilder
AddLine '/*********************************************************************************'
AddLine '* @Copyright(C), 2026 ISTAR. All rights reserved.'
AddLine '* @FileName: motion_stage_id.h'
AddLine '* @Description: motion stage name enum, generated from config, like io_var_id.h.'
AddLine '*               generated by gen_motion_id.bat - do not edit by hand.'
AddLine '*'
AddLine '* Usage:'
AddLine '*   MotionManager::getInstance()->Enable(StageName::WS_LS);'
AddLine '*   MotionManager::getInstance()->MoveAbs(StageName::WS_LS, {1.0, 2.0});'
AddLine '*   double x = MotionManager::getInstance()->GetPos(StageName::WS_LS)[Axis::WS_LS::X];'
AddLine '*********************************************************************************/'
AddLine '#ifndef __MOTION_STAGE_ID_H__'
AddLine '#define __MOTION_STAGE_ID_H__'
AddLine ''
AddLine '#include "motion_axis_id.h"'
AddLine ''
AddLine 'enum class StageName'
AddLine '{'
foreach ($st in $stages) {
    AddLine ('    ' + $st.name + ',')
}
AddLine '    _COUNT // iterate helper, must stay last'
AddLine '};'
AddLine ''
AddLine '#endif // __MOTION_STAGE_ID_H__'

[System.IO.File]::WriteAllText($stageOut, $out.ToString(), $utf8NoBom)
Write-Host "[OK] Generated: $stageOut"
rem ===== PS-END =====
